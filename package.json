{
  "name": "neutrino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/",
    "clean": "rm -rf dist target",
    "db:create": "cd src-tauri && sqlx database create",
    "db:migrate": "cd src-tauri && sqlx migrate run",
    "db:prepare": "cd src-tauri && cargo sqlx prepare",
    "db:reset": "cd src-tauri && sqlx database drop -y && sqlx database create && sqlx migrate run",
    "db:update": "npm run db:migrate && npm run db:prepare"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.63.6",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.2.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.2.2",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.461.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.13",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.7.0",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "baseline-browser-mapping": "^2.8.32",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
