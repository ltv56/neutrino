{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neutrino",
  "version": "0.1.0",
  "identifier": "com.neutrino.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npx cross-env BROWSER=none npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Neutrino",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Context-aware knowledge capture for academic research",
    "longDescription": "Neutrino provides intelligent, real-time cognitive assistance to researchers during document reading and analysis."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
