  "query": "\n            SELECT n.id, n.session_id, n.document_id, n.title, n.content,\n                   n.note_type, n.position, n.tags, n.created_at, n.updated_at\n            FROM notes n\n            INNER JOIN notes_fts fts ON n.id = fts.id\n            WHERE notes_fts MATCH ?\n            ORDER BY rank\n            ",
