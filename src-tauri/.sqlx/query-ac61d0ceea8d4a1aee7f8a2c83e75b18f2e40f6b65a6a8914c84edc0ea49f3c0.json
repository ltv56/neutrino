  "query": "\n            SELECT d.id, d.title, d.file_path, d.content_type,\n                   d.metadata, d.reading_progress, d.created_at, d.updated_at\n            FROM documents d\n            INNER JOIN documents_fts fts ON d.id = fts.id\n            WHERE documents_fts MATCH ?\n            ORDER BY rank\n            ",
