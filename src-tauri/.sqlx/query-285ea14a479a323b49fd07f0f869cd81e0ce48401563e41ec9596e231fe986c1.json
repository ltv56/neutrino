  "query": "SELECT d.id, d.title, d.file_path, d.content_type, d.metadata,\n                    d.reading_progress, d.created_at, d.updated_at\n             FROM documents d\n             INNER JOIN session_documents sd ON d.id = sd.document_id\n             WHERE sd.session_id = ?\n             ORDER BY sd.added_at DESC",
